<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YT Bass Gaming</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{
    font-family:'Poppins',sans-serif;
    background:#0a0a0a;
    color:white;
}

/* NAVBAR */
nav{
    display:flex;
    justify-content:space-between;
    padding:15px 40px;
    background:#000;
    position:sticky;
    top:0;
}
nav h2{color:#00ffff;}
nav a{
    color:white;
    margin-left:20px;
    text-decoration:none;
}

/* HERO */
.hero{
    height:90vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}
.hero h1{
    font-size:50px;
    color:#00ffff;
}
.hero button{
    margin-top:20px;
    padding:12px 25px;
    background:red;
    border:none;
    color:white;
    cursor:pointer;
}

/* SECTION */
.section{
    padding:50px;
    text-align:center;
}
.cards{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
}
.card{
    background:#111;
    margin:15px;
    padding:20px;
    width:250px;
    border-radius:10px;
    transition:0.3s;
}
.card:hover{
    transform:scale(1.05);
}

/* VIDEOS */
iframe{
    border:none;
    border-radius:10px;
    margin:10px;
}

/* FOOTER */
footer{
    padding:20px;
    text-align:center;
    background:#000;
}
</style>
</head>

<body>

<nav>
    <h2>🎮 YT Bass Gaming</h2>
    <div>
        <a href="#">Home</a>
        <a href="#videos">Videos</a>
        <a href="#about">About</a>
    </div>
</nav>

<section class="hero">
    <h1>🔥 YT Bass Gaming 🔥</h1>
    <p>Gameplay | Funny | Live 🔴</p>
    <button onclick="window.open('https://youtube.com/@ytbassgaming')">
        🔴 Subscribe Now
    </button>
</section>

<section class="section">
    <h2>⚡ Content</h2>
    <div class="cards">
        <div class="card">🎯 Gameplay</div>
        <div class="card">😂 Funny Moments</div>
        <div class="card">🔥 Live Streaming</div>
    </div>
</section>

<section class="section" id="videos">
    <h2>🎥 Latest Videos</h2>

    <!-- Replace VIDEO IDs below -->
    <iframe width="300" height="170"
    src="https://www.youtube.com/embed?listType=user_uploads&list=ytbassgaming"></iframe>

</section>

<section class="section" id="about">
    <h2>👑 About</h2>
    <p>Welcome to YT Bass Gaming 🔥<br>
    Subscribe for awesome gaming content!</p>
</section>

<footer>
    <p>© 2026 YT Bass Gaming</p>
</footer>

</body>
</html>
